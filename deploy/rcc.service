[Unit]
Description=Remote Claude Code Server
After=network.target

[Service]
Type=simple
User=<your-user>
WorkingDirectory=/path/to/remote-claude-code
ExecStart=/home/<your-user>/.nvm/versions/node/<node-version>/bin/node --import tsx server/src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rcc

# Environment (alternatively use EnvironmentFile)
EnvironmentFile=/path/to/remote-claude-code/.env

# nvm으로 설치한 Node.js / Claude CLI PATH
Environment=PATH=/home/<your-user>/.nvm/versions/node/<node-version>/bin:/home/<your-user>/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
